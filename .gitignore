## Ignore Visual Studio temporary files, build results, and
## files generated by popular .NET tools.

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# Visual Studio cache/options
.vs/
*.VC.db
*.VC.VC.opendb

# Rider / JetBrains
.idea/
*.sln.iml

# VS Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# NuGet
*.nupkg
**/[Pp]ackages/*
!**/[Pp]ackages/build/
*.nuget.props
*.nuget.targets
project.lock.json
project.fragment.lock.json
artifacts/

# ASP.NET Scaffolding
ScaffoldingReadMe.txt

# StyleCop
StyleCopReport.xml

# Files built by Visual Studio
*_i.c
*_p.c
*_h.h
*.ilk
*.meta
*.obj
*.iobj
*.pch
*.pdb
*.ipdb
*.pgc
*.pgd
*.rsp
*.sbr
*.tlb
*.tli
*.tlh
*.tmp
*.tmp_proj
*_wpftmp.csproj
*.log
*.tlog
*.vspscc
*.vssscc
.builds
*.pidb
*.svclog
*.scc

# Local History
.localhistory/

# Windows image file caches
Thumbs.db
ehthumbs.db
Desktop.ini

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Linux
*~

# Dotnet tool
.dotnet/

# Entity Framework
**/Migrations/*.Designer.cs.bak

# User secrets / local settings (مهم)
**/appsettings.Development.json
**/appsettings.Local.json
**/appsettings.*.local.json
secrets.json

# Uploads / local storage (اگر فایل‌ها رو لوکال نگه می‌داری)
uploads/
**/uploads/
wwwroot/uploads/

# Logs
*.log
logs/
**/logs/

# Test results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*
*.trx
*.coverage
*.coveragexml
coverage/

# NCrunch
_NCrunch_*
.*crunch*.local.xml
nCrunchTemp_*

# Others
*.cache
*.dbmdl
*.jfm
*.pfx
*.publishsettings
orleans.codegen.cs

# Location seed data (کشور / استان / شهر)
**/Seeders/Data/countries.json
**/Seeders/Data/states.json
**/Seeders/Data/cities.json
**/Seeders/Data/*.json